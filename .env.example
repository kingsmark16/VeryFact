# Gemini (Phase 1) - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REQUEST_TIMEOUT=60s
# Free Google results through SerpApi; use a free account and stay within its allowance.
GOOGLE_SEARCH_PROVIDER=serpapi
SERPAPI_API_KEY=
# Google Fact Check Tools API (Phase 2)
GOOGLE_FACTCHECK_API_KEY=

POSTGRES_DB=veryfact
POSTGRES_USER=veryfact
POSTGRES_PASSWORD=change-me
RATE_LIMIT_PER_HOUR=10
